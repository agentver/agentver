{
  "name": "agentver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@prisma/client",
    "prisma"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@agentver/dashboard",
    "dev:all": "turbo dev --filter=@agentver/dashboard --filter=@agentver/website --continue",
    "dev:dashboard": "turbo dev --filter=@agentver/dashboard",
    "dev:website": "turbo dev --filter=@agentver/website",
    "dev:desktop": "turbo desktop:dev --filter=@agentver/desktop",
    "build": "turbo build --filter='!@agentver/desktop'",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules apps/*/.next",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:reset": "turbo db:reset",
    "db:migrate:dev": "turbo db:migrate:dev",
    "db:migrate:deploy": "turbo db:migrate:deploy",
    "db:seed": "bun run --cwd packages/database prisma db seed",
    "db:studio": "turbo db:studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.7.0",
    "@vitest/coverage-v8": "^4.1.0",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "turbo": "^2.8.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@types/pg": "8.11.11"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "better-auth": "^1.5.5"
  }
}

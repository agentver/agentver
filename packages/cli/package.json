{
  "name": "@agentver/cli",
  "version": "0.3.3",
  "type": "module",
  "description": "Team-grade skill management for AI coding assistants — version, audit, and deploy to 43+ agents",
  "bin": {
    "agentver": "./dist/agentver.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "open": "^10.1.2",
    "ora": "^8.2.0",
    "prompts": "^2.4.2",
    "update-notifier": "^7.3.1",
    "yaml": "^2.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@agentver/agent-definitions": "workspace:*",
    "@agentver/shared": "workspace:*",
    "@agentver/typescript-config": "workspace:*",
    "@types/prompts": "^2.4.9",
    "@types/update-notifier": "^6.0.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "ai",
    "agent",
    "skill",
    "registry",
    "cli",
    "claude",
    "cursor",
    "codex"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "Agentver <hello@agentver.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentver/agentver.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/agentver/agentver/issues"
  },
  "homepage": "https://agentver.com"
}

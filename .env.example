# ==============================================================================
# Agentver — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values.
# Required variables are marked with [REQUIRED].
# Optional variables have sensible defaults or enable additional features.

# ------------------------------------------------------------------------------
# Database [REQUIRED]
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://agentver:local@localhost:5434/agentver"

# ------------------------------------------------------------------------------
# Authentication — Better Auth [REQUIRED]
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=""              # Required, min 32 chars (generate with: openssl rand -base64 32)
GITHUB_CLIENT_ID=""                # Optional, for GitHub OAuth login
GITHUB_CLIENT_SECRET=""            # Optional
GOOGLE_CLIENT_ID=""                # Optional, for Google OAuth login
GOOGLE_CLIENT_SECRET=""            # Optional

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# Public URL of the platform (used for OAuth callbacks and imports)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ------------------------------------------------------------------------------
# Redis (optional — enables caching and Redis-backed rate limiting)
# ------------------------------------------------------------------------------
# Platform works without Redis; caching and Redis rate limiting are skipped.
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# Token Encryption
# ------------------------------------------------------------------------------
# AES-256-GCM key for encrypting OAuth tokens at rest.
# Must be exactly 32 bytes, base64-encoded.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# OAuth Providers (for import connectors)
# ------------------------------------------------------------------------------
# Each provider needs both CLIENT_ID and CLIENT_SECRET to be functional.
# Partially configured providers will log a warning on startup.

# GitHub Webhooks (for sync)
# GITHUB_WEBHOOK_SECRET=""

# GitLab
# GITLAB_CLIENT_ID=""
# GITLAB_CLIENT_SECRET=""

# Bitbucket
# BITBUCKET_CLIENT_ID=""
# BITBUCKET_CLIENT_SECRET=""

# Google Drive
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI=""

# Microsoft OneDrive
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_REDIRECT_URI=""

# ------------------------------------------------------------------------------
# Email (optional — defaults to console logging)
# ------------------------------------------------------------------------------
# Set EMAIL_PROVIDER to "smtp" to send real emails.
# EMAIL_PROVIDER="console"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="noreply@localhost"

# ------------------------------------------------------------------------------
# Storage (optional — defaults to local filesystem)
# ------------------------------------------------------------------------------
# Set STORAGE_ADAPTER to "s3" for S3-compatible storage (AWS, MinIO, R2).
# STORAGE_ADAPTER="local"
# STORAGE_PATH="./.data/storage"
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# Edition
# ------------------------------------------------------------------------------
# Set to "true" for cloud-hosted edition (enables billing, admin, etc.)
# AGENTVER_CLOUD="false"
# Set to your licence key for enterprise edition
# AGENTVER_LICENCE_KEY=""

# ------------------------------------------------------------------------------
# Stripe (cloud edition only)
# ------------------------------------------------------------------------------
# Required when AGENTVER_CLOUD=true
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# Forgejo Git Backend
# ------------------------------------------------------------------------------
# Self-hosted Forgejo instance used as the git-native storage backend.
FORGEJO_API_URL=""
FORGEJO_API_TOKEN=""
FORGEJO_SSH_HOST=""
FORGEJO_SSH_PORT="22"

# ------------------------------------------------------------------------------
# Access Control
# ------------------------------------------------------------------------------
# Comma-separated email domains allowed to sign up (empty = anyone)
ALLOWED_SIGNUP_DOMAINS=
# Comma-separated admin email addresses (cloud edition)
PLATFORM_ADMIN_EMAILS=

# ------------------------------------------------------------------------------
# E2E Testing (Playwright)
# ------------------------------------------------------------------------------
# Credentials for the test user account. Set these to run authenticated E2E tests.
# The test suite auto-creates this user via sign-up if it does not exist.
# E2E_TEST_EMAIL="e2e-test@agentver.com"
# E2E_TEST_PASSWORD="TestPassword123!"

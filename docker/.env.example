# =============================================================================
# Agentver — Self-Hosted Configuration
# =============================================================================
# Copy this file to .env or run ./setup.sh to generate it automatically.
# Required variables are marked; everything else has sensible defaults.
# =============================================================================

# --- Required ----------------------------------------------------------------

DATABASE_URL=postgresql://agentver:${POSTGRES_PASSWORD}@postgres:5432/agentver
POSTGRES_PASSWORD=                    # Generated by setup.sh
BETTER_AUTH_SECRET=                   # Min 32 chars, generated by setup.sh
APP_URL=http://localhost:3000         # Your public-facing URL
TOKEN_ENCRYPTION_KEY=                 # AES-256-GCM key, generated by setup.sh

# --- Email (optional — defaults to console logging) -------------------------

EMAIL_PROVIDER=console                # console | smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@yourdomain.com

# --- Storage (optional — defaults to local filesystem) ----------------------

STORAGE_ADAPTER=local                 # local | s3
# STORAGE_PATH=./.data/storage
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Git server (optional, requires --profile git) --------------------------

# FORGEJO_API_URL=http://forgejo:3000/api/v1
# FORGEJO_API_TOKEN=
# FORGEJO_SSH_HOST=
# FORGEJO_SSH_PORT=22

# --- Redis (optional, requires --profile cache) -----------------------------

# REDIS_URL=redis://redis:6379

# --- OAuth login providers (optional) ---------------------------------------

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- OAuth import connectors (optional) -------------------------------------
# Each provider needs both CLIENT_ID and CLIENT_SECRET to be functional.

# GitHub (also used for webhook sync)
# GITHUB_WEBHOOK_SECRET=

# GitLab
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=

# Bitbucket
# BITBUCKET_CLIENT_ID=
# BITBUCKET_CLIENT_SECRET=

# Google Drive
# GOOGLE_REDIRECT_URI=

# Microsoft OneDrive
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=

# --- Edition -----------------------------------------------------------------

# AGENTVER_CLOUD=false
# AGENTVER_LICENCE_KEY=

# --- Access Control -----------------------------------------------------------

# Comma-separated email domains allowed to sign up (empty = anyone)
ALLOWED_SIGNUP_DOMAINS=
# Comma-separated admin email addresses (cloud edition)
PLATFORM_ADMIN_EMAILS=
